# Donkey Kong Country: Tropical Freeze (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_DKCTF_*.

# --- PRUDP listeners ---
PN_DKCTF_AUTH_PORT=28000
PN_DKCTF_SECURE_PORT=28001
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_DKCTF_SECURE_HOST=localhost

# --- Database (ranking + DataStore + matchmaking, one database) ---
PN_DKCTF_POSTGRES_URI=postgres://dkctf:dkctf@localhost:5432/dkctf?sslmode=disable

# --- Kerberos / system accounts ---
PN_DKCTF_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_DKCTF_LOCAL_MODE=1
PN_DKCTF_SETTINGS_PATH=settings.json

# Required only when PN_DKCTF_LOCAL_MODE is not 1:
PN_DKCTF_NEX_TOKEN_AES_KEY=
PN_DKCTF_NEX_PASSWORD_SECRET=

# --- Optional: DataStore object uploads -----
# Only needed if players PUBLISH objects. Downloading works without S3.
PN_S3_ENDPOINT=
PN_S3_ACCESS_KEY=
PN_S3_SECRET_KEY=
PN_S3_BUCKET=dkctf-datastore
